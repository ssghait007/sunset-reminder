#!/bin/zsh
# Spoken sunset reminder. launchd starts this at every bucket time used in the
# current month (plist generated by ~/.local/share/sunset-reminder/generate.py);
# the script speaks only if today's bucket time has arrived and sunset hasn't.
#   --now   skip the checks and speak immediately
dir=~/.local/share/sunset-reminder
state=~/.local/state/sunset-reminder-last

if [[ $1 != --now ]]; then
  [[ $(cat $state 2>/dev/null) == $(date +%F) ]] && exit 0   # already spoke today
  read remind sunset < <(awk -v d=$(date +%m%d) '!/^#/ && d >= $1 && d <= $2 { print $3, $4 }' $dir/schedule.tsv)
  now=$(date +%H:%M)
  [[ $now < $remind ]] && exit 0     # an earlier slot this month, not today's
  [[ $now < $sunset ]] || exit 0     # missed while asleep and the sun has set
  mkdir -p ${state:h} && date +%F > $state
fi

msgs=("${(@f)$(<$dir/messages.txt)}")
afplay /System/Library/Sounds/Glass.aiff
sleep 1
say "${msgs[RANDOM % $#msgs + 1]}"
